{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "rootDir": "..",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src", "tests", "vitest.config.ts", "../shared/types.ts"]
}
