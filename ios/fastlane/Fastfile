# Latent fastlane. Run from ios/:  bundle exec fastlane <lane>
# See docs/TESTFLIGHT.md for the full setup guide.

default_platform(:ios)

APP_ID  = ENV["APP_IDENTIFIER"] || "com.benjaminhannan.latent"
SCHEME  = "Latent"

platform :ios do
  # ---- helpers -------------------------------------------------------------

  def generate_project
    sh("cd .. && xcodegen generate")
  end

  def require_env!(*names)
    missing = names.select { |n| ENV[n].to_s.empty? }
    UI.user_error!("Missing required environment variables: #{missing.join(', ')}") unless missing.empty?
  end

  def asc_api_key
    require_env!("ASC_KEY_ID", "ASC_ISSUER_ID", "ASC_KEY_P8_BASE64")
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true,
      in_house: false
    )
  end

  # ---- lanes ---------------------------------------------------------------

  desc "Run unit tests on an iPhone simulator"
  lane :tests do
    generate_project
    run_tests(
      project: "Latent.xcodeproj",
      scheme: SCHEME,
      device: ENV["TEST_DEVICE"] || "iPhone 16",
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      result_bundle: true,
      output_directory: "build/test_output"
    )
  end

  desc "Create the bundle ID and App Store Connect app record if missing (one-time)"
  lane :register_app do
    api_key = asc_api_key
    produce(
      api_key: api_key,
      app_identifier: APP_ID,
      app_name: ENV["APP_NAME"] || "Latent",
      language: "en-US",
      sku: ENV["APP_SKU"] || "latent-ios",
      platforms: ["ios"],
      team_id: ENV["APPLE_TEAM_ID"]
    )
    # NOTE: if `produce` cannot create the app record with an API key (Apple restricts this),
    # create it once in the App Store Connect web UI. The bundle ID is still registered here.
  end

  desc "Build and upload to TestFlight (CI and local)"
  lane :beta do
    require_env!("APPLE_TEAM_ID")
    api_key = asc_api_key

    generate_project

    if is_ci
      require_env!("IOS_DIST_CERT_P12_BASE64", "IOS_DIST_CERT_PASSWORD")
      setup_ci # temporary keychain + match-style settings
      p12_path = File.join(Dir.tmpdir, "latent_dist.p12")
      File.binwrite(p12_path, Base64.decode64(ENV["IOS_DIST_CERT_P12_BASE64"]))
      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV["IOS_DIST_CERT_PASSWORD"],
        keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain",
        keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "",
        log_output: false
      )
    end

    # Download (or create) an App Store distribution provisioning profile.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_ID,
      team_id: ENV["APPLE_TEAM_ID"],
      provisioning_name: "Latent AppStore",
      force: true
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Latent.xcodeproj",
      targets: ["Latent"],
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: APP_ID
    )

    # Build number = latest TestFlight build + 1 (falls back to the GitHub run number).
    build_number =
      begin
        latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID) + 1
      rescue StandardError => e
        UI.important("Could not read latest TestFlight build (#{e.message}); falling back to GITHUB_RUN_NUMBER")
        (ENV["GITHUB_RUN_NUMBER"] || "1").to_i
      end
    UI.message("Using build number #{build_number}")

    build_app(
      project: "Latent.xcodeproj",
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Latent.ipa",
      clean: true,
      export_options: {
        method: "app-store",
        teamID: ENV["APPLE_TEAM_ID"],
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => profile_name }
      },
      # CURRENT_PROJECT_VERSION on the command line overrides the xcconfig value (agvtool/increment_build_number
      # does not apply because the version lives in Config/Base.xcconfig).
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )

    changelog = (sh("git log -1 --pretty=%B", log: false) rescue "Latent build #{build_number}").to_s.strip
    changelog = "Latent build #{build_number}" if changelog.empty?

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
      changelog: changelog,
      distribute_external: false
    )
  end
end
